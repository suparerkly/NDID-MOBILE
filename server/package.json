{
  "name": "ndid-mock-server",
  "private": true,
  "type": "module",
  "description": "Mock API server with Prisma + SQLite for NDID Verify LOSE (development only)",
  "scripts": {
    "setup": "prisma db push && node prisma/seed.js",
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "db:seed": "node prisma/seed.js",
    "db:reset": "prisma db push --force-reset && node prisma/seed.js",
    "db:studio": "prisma studio",
    "test": "node scripts/with-test-db.js node --test --test-concurrency=1 test/*.test.js",
    "start:test": "node scripts/with-test-db.js node src/server.js"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "express": "^5.3.0"
  },
  "devDependencies": {
    "prisma": "^6.19.3"
  }
}
