{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "web-build",
      "runtimeExecutable": "python",
      "runtimeArgs": ["-m", "http.server", "8080", "--directory", "build/web"],
      "port": 8080
    },
    {
      "name": "mock-server",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "server", "start"],
      "port": 3000,
      "url": "http://localhost:3000"
    },
    {
      "name": "prisma-studio",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "server", "run", "db:studio", "--", "--browser", "none", "--port", "5555"],
      "port": 5555
    }
  ]
}
